# Use 127.0.0.1 (not localhost) so Node connects over IPv4. On Windows, `localhost`
# may resolve to IPv6 (::1) which a default PostgreSQL install does not listen on.
DATABASE_URL=postgresql://postgres:yourpassword@127.0.0.1:5432/cashflow_ic_dashboard
SESSION_SECRET=change-this-to-a-random-string
PORT=3000
NODE_ENV=production
